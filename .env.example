# Copy this file to .env and fill in your own values.
# Never commit the real .env file or hard-code the key in source.

# Required: your Gemini API key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: override the Gemini model used for reasoning (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Optional: set to true to enable Flask debug/auto-reload during local dev
FLASK_DEBUG=false
